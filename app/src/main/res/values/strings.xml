    <!-- Ajuda -->
    <string name="help_engines_title">Engines</string>
    <string name="help_engines_body">NewPipe handles the main sites without extra weight. When a site is not covered, or when the format needs merging or conversion, yt-dlp takes over — it ships with its own Python and ffmpeg.</string>
    <string name="help_spotify_title">Spotify links</string>
    <string name="help_spotify_body">Spotify is DRM-protected, so nothing is downloaded from it. The app reads the public metadata and finds the same track on YouTube.</string>
    <string name="help_storage_title">Where files land</string>
    <string name="help_storage_body">By default, Movies and Music on your device, visible to any gallery or player. You can point downloads at another folder in Settings.</string>
    <string name="help_403_title">Access denied (403)</string>
    <string name="help_403_body">YouTube rejects an outdated yt-dlp. The app updates it and retries once on its own; if it keeps failing, wait a few minutes and try again.</string>
